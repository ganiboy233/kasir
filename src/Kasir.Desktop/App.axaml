<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kasir.Desktop.App"
             xmlns:local="using:Kasir.Desktop"
             RequestedThemeVariant="Light">
             <!-- Light dikunci sebagai default toko. Ikuti sistem hanya setelah tema gelap siap di Fase 8. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Kasir.Desktop/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Kasir.Desktop/Styles/Text.axaml" />
        <StyleInclude Source="avares://Kasir.Desktop/Styles/Buttons.axaml" />
        <StyleInclude Source="avares://Kasir.Desktop/Styles/Inputs.axaml" />
        <StyleInclude Source="avares://Kasir.Desktop/Styles/Tables.axaml" />
        <StyleInclude Source="avares://Kasir.Desktop/Styles/Dialogs.axaml" />
    </Application.Styles>
</Application>
